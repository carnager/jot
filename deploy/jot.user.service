[Unit]
Description=Jot notes & todos
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=%h/.local/bin/jot serve
Environment="JOT_ADDR=127.0.0.1:5566"
Environment="JOT_DATA=%h/.local/share/jot"
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=default.target
