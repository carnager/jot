# Read by jot.service (system) and, as ~/.config/jot.env, by the user service.
# Put a TLS reverse proxy (Caddy, nginx) in front for access from outside.

#JOT_ADDR=127.0.0.1:8080

# Illustrations: the server paints pictures for notes (turn on in the web app's Settings).
#JOT_OPENAI_KEY=sk-...
#JOT_ART_MODEL=gpt-image-1-mini
#JOT_ART_QUALITY=medium
#JOT_ART_DAILY_LIMIT=25
#JOT_ART_TEXT_MODEL=gpt-5.4-mini
