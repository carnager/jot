# Maintainer: Rasi <rasi@xssn.at>

# Built from the local repository's committed state (git+file), so the version follows the commits.
pkgname=jot
pkgver=r0
pkgrel=1
pkgdesc='Self-hosted notes and todos server with a built-in web app (Google Keep replacement)'
arch=('x86_64' 'aarch64')
url='https://jot.mooned.de'
license=('custom:none')
depends=('glibc')
makedepends=('go>=2:1.27' 'git')
optdepends=('restic: nightly backups with jot-backup'
            'sqlite: consistent database snapshots for jot-backup')
backup=('etc/jot.env')
install=jot.install
source=("jot::git+file://${JOT_SRC:-$HOME/Code/Notes}")
sha256sums=('SKIP')

pkgver() {
  cd jot
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd jot/server
  export GOPATH="$srcdir/gopath"
  go mod download
}

build() {
  cd jot/server
  export GOPATH="$srcdir/gopath"
  export CGO_ENABLED=0
  export GOFLAGS='-buildmode=pie -trimpath -mod=readonly -modcacherw'
  go build -ldflags '-s -w' -o jot .
}

check() {
  cd jot/server
  export GOPATH="$srcdir/gopath"
  export CGO_ENABLED=0
  go test ./...
}

package() {
  cd jot
  install -Dm755 server/jot "$pkgdir/usr/bin/jot"
  install -Dm755 deploy/backup.sh "$pkgdir/usr/bin/jot-backup"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 SPEC.md "$pkgdir/usr/share/doc/$pkgname/SPEC.md"
  install -Dm644 packaging/arch/jot.service "$pkgdir/usr/lib/systemd/system/jot.service"
  install -Dm644 packaging/arch/jot.user.service "$pkgdir/usr/lib/systemd/user/jot.service"
  install -Dm644 packaging/arch/jot.sysusers "$pkgdir/usr/lib/sysusers.d/jot.conf"
  install -Dm600 packaging/arch/jot.env "$pkgdir/etc/jot.env"
}
